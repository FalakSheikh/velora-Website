# Copy this file to .env and fill it in. Never share your .env file.
PORT=3000
# Required when NODE_ENV=production. Use a long random text.
SESSION_SECRET=
# The email that becomes admin when it signs up
ADMIN_EMAIL=
# Optional: turns on real AI scan and chat (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional: turns on Google sign-in
GOOGLE_CLIENT_ID=
# Optional: photo-real virtual try-on on the member's own photo (pick ONE)
# Google Gemini key from https://aistudio.google.com (has a free allowance; check that image creation is included for you)
GEMINI_API_KEY=AQ.Ab8RN6JpP7tSn1vySHiq7QZLzwroZ1mWbYy5zqg1sX1m0Doa3Q
# or a fal.ai key from https://fal.ai (paid, small cost per picture; uses one garment at a time)
FAL_KEY=
